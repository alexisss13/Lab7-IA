@model Lab7_IA.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="form-container">
    <div class="form-header">
        <div>
            <h1 class="form-title">
                <i class="bi bi-pencil-square"></i>
                Editar Producto
            </h1>
            <p class="form-subtitle">Modifica la información del producto</p>
        </div>
        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Volver
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert-error">
            <i class="bi bi-exclamation-circle"></i>
            <span>@ViewBag.Error</span>
        </div>
    }

    <div class="form-card">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="IdProducto" />
            
            <div class="form-grid">
                <div class="form-group full-width">
                    <label asp-for="NombreProducto" class="form-label">
                        <i class="bi bi-box"></i>
                        Nombre del Producto
                    </label>
                    <input asp-for="NombreProducto" class="form-input" placeholder="Ingrese el nombre del producto" required maxlength="40" />
                    <span asp-validation-for="NombreProducto" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="IdCategoria" class="form-label">
                        <i class="bi bi-tag"></i>
                        Categoría
                    </label>
                    <select asp-for="IdCategoria" class="form-select" required>
                        <option value="">Seleccione una categoría</option>
                        @foreach (var categoria in ViewBag.Categorias)
                        {
                            <option value="@categoria.IdCategoria">@categoria.NombreCategoria</option>
                        }
                    </select>
                    <span asp-validation-for="IdCategoria" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="IdProveedor" class="form-label">
                        <i class="bi bi-building"></i>
                        Proveedor
                    </label>
                    <select asp-for="IdProveedor" class="form-select" required>
                        <option value="">Seleccione un proveedor</option>
                        @foreach (var proveedor in ViewBag.Proveedores)
                        {
                            <option value="@proveedor.IdProveedor">@proveedor.NombreCia</option>
                        }
                    </select>
                    <span asp-validation-for="IdProveedor" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Umedida" class="form-label">
                        <i class="bi bi-rulers"></i>
                        Unidad de Medida
                    </label>
                    <input asp-for="Umedida" class="form-input" placeholder="Ej: 12 - bot. 500 ml" maxlength="100" />
                    <span asp-validation-for="Umedida" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PrecioUnidad" class="form-label">
                        <i class="bi bi-currency-dollar"></i>
                        Precio Unitario
                    </label>
                    <input asp-for="PrecioUnidad" type="number" step="0.01" min="0.01" class="form-input" placeholder="0.00" required />
                    <span asp-validation-for="PrecioUnidad" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="UnidadesEnExistencia" class="form-label">
                        <i class="bi bi-boxes"></i>
                        Stock
                    </label>
                    <input asp-for="UnidadesEnExistencia" type="number" min="0" max="32767" class="form-input" placeholder="0" required />
                    <span asp-validation-for="UnidadesEnExistencia" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn-secondary">
                    <i class="bi bi-x-circle"></i>
                    Cancelar
                </a>
                <button type="submit" class="btn-primary">
                    <i class="bi bi-check-circle"></i>
                    Actualizar Producto
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .form-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    .form-title {
        font-size: 2rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0 0 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .form-title i {
        font-size: 1.75rem;
        color: #ff9500;
    }

    .form-subtitle {
        color: #6e6e73;
        font-size: 1rem;
        margin: 0;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: rgba(0, 0, 0, 0.04);
        color: #1d1d1f;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .btn-back:hover {
        background: rgba(0, 0, 0, 0.08);
        color: #1d1d1f;
        transform: translateY(-1px);
    }

    .alert-error {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        background: rgba(255, 59, 48, 0.1);
        border: 1px solid rgba(255, 59, 48, 0.3);
        color: #c41e3a;
    }

    .form-card {
        background: rgba(255, 255, 255, 0.8);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 0, 0, 0.06);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
        color: #1d1d1f;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-label i {
        color: #ff9500;
        font-size: 1rem;
    }

    .form-input, .form-select {
        padding: 0.875rem 1rem;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 10px;
        font-size: 1rem;
        transition: all 0.2s ease;
        background: rgba(255, 255, 255, 0.9);
        color: #1d1d1f;
    }

    .form-input:focus, .form-select:focus {
        outline: none;
        border-color: #ff9500;
        box-shadow: 0 0 0 4px rgba(255, 149, 0, 0.1);
        background: white;
    }

    .form-input::placeholder {
        color: #86868b;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(0, 0, 0, 0.06);
    }

    .btn-primary, .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.75rem;
        border-radius: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        font-size: 1rem;
    }

    .btn-primary {
        background: rgba(255, 149, 0, 0.95);
        color: white;
    }

    .btn-primary:hover {
        background: rgba(255, 149, 0, 1);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 149, 0, 0.3);
    }

    .btn-secondary {
        background: rgba(0, 0, 0, 0.04);
        color: #1d1d1f;
    }

    .btn-secondary:hover {
        background: rgba(0, 0, 0, 0.08);
        color: #1d1d1f;
    }

    .text-danger {
        color: #c41e3a;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

   
</style>
